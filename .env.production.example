# Production Environment Variables
# Copy this file to .env on your production server and fill in the values

# Database Configuration
DATABASE_URL=postgres://avena:YOUR_STRONG_PASSWORD@postgres:5432/avena_db
POSTGRES_USER=avena
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD
POSTGRES_DB=avena_db

# Better Auth Configuration
BETTER_AUTH_SECRET=YOUR_LONG_RANDOM_SECRET_HERE_MIN_32_CHARS
BETTER_AUTH_URL=https://your-domain.com

# Docker Image Tag (automatically set by CI/CD)
IMAGE_TAG=latest

# OpenAI API Key
OPENAI_API_KEY=put-your-openai-api-key-here
