{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "avena-be",
	"main": "src/index.ts",
	"compatibility_date": "2026-02-12",
	"assets": {
		"binding": "ASSETS",
		"directory": "./public"
	},
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat",
		"nodejs_compat_populate_process_env"
	],
	"workers_dev": false,
	"routes": [
		{
			"pattern": "avena.henriquesf.me",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "avena_db",
			"database_name": "avena-db",
			"database_id": "6836bbb3-a051-4377-94e6-95e180391a17",
			"migrations_dir": "drizzle"
		}
	]
}
